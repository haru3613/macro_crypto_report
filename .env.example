# Required for CPI/NFP/ISM data (free: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Optional: FMP for consensus/expected values (paid plan required for economic-calendar)
# If empty, falls back to Investing.com (free, no key needed)
FMP_API_KEY=

# App settings
LOG_LEVEL=INFO
SQLITE_PATH=runtime/macro_crypto.db
TOP_N_SYMBOLS=10
SHORT_REFRESH_MINUTES=15
LONG_REFRESH_HOURS=24
