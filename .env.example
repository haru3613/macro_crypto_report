# Required for CPI/NFP/ISM data (free: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Optional: Gemini for AI analysis (fallback rules used if empty)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# App settings
LOG_LEVEL=INFO
SQLITE_PATH=runtime/macro_crypto.db
TOP_N_SYMBOLS=10
SHORT_REFRESH_MINUTES=15
LONG_REFRESH_HOURS=24
