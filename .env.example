# Required for CPI/NFP/ISM data (free: https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# Optional: OpenAI for AI analysis (fallback rules used if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1/responses

# App settings
LOG_LEVEL=INFO
SQLITE_PATH=runtime/macro_crypto.db
TOP_N_SYMBOLS=10
SHORT_REFRESH_MINUTES=15
LONG_REFRESH_HOURS=24
